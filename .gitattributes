# 默认按文本处理，仓库内统一 LF，避免 CRLF 反复触发 "will be replaced" 警告
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制，不做换行转换与文本 diff
*.zip   binary
*.rar   binary
*.7z    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp3   binary
*.mp4   binary

# 文档中英混排，diff 时更容易看出改动
*.md diff=markdown
